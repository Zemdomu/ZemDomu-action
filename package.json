{
  "name": "zemdomu-action",
  "version": "0.1.0",
  "description": "GitHub Action for ZemDomu semantic linting",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:tsc": "tsc",
    "build:ncc": "ncc build src/index.ts --license licenses.txt -o dist",
    "build": "npm run clean && npm run build:ncc",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.1",
    "glob": "^10.4.5",
    "zemdomu": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vercel/ncc": "^0.38.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
