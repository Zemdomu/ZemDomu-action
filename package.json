{
  "name": "zemdomu-action",
  "version": "0.3.0",
  "description": "GitHub Action for ZemDomu semantic linting",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:core": "node scripts/build-core-if-present.js",
    "build:tsc": "tsc",
    "build:ncc": "ncc build src/index.ts --license licenses.txt -o dist",
    "build": "npm run clean && npm run build:core && npm run build:ncc",
    "prepare": "npm run build",
    "test": "npm run build && node tests/run-action.test.js && node tests/multiple-h1-action.test.js"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.1",
    "glob": "^10.5.0",
    "zemdomu": "^1.3.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vercel/ncc": "^0.38.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "glob@^11.0.0": "11.1.0"
  }
}
