{
  "name": "zemdomu-action",
  "version": "0.3.5",
  "description": "GitHub Action that runs ZemDomu Core semantic accessibility checks and reports pull-request annotations",
  "funding": "https://buymeacoffee.com/zemdomu",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:core": "node scripts/build-core-if-present.js",
    "build:tsc": "tsc",
    "build:ncc": "ncc build src/index.ts --license licenses.txt -o dist",
    "build": "npm run clean && npm run build:core && npm run build:ncc",
    "prepare": "npm run build",
    "test": "npm run build && node tests/run-action.test.js && node tests/multiple-h1-action.test.js"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.0.0",
    "glob": "^10.5.0",
    "zemdomu": "^1.3.17"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vercel/ncc": "^0.38.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.6",
    "brace-expansion@^2.0.0": "2.0.3",
    "glob@^11.0.0": "11.1.0",
    "minimatch@^9.0.0": "9.0.7",
    "minimatch@^10.0.0": "10.2.4",
    "undici": "6.28.0"
  }
}
