{
  "name": "zemdomu-action",
  "version": "0.3.8",
  "description": "GitHub Action that runs ZemDomu Core semantic accessibility checks and reports pull-request annotations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zemdomu/ZemDomu-action.git"
  },
  "homepage": "https://zemdomu.dev/",
  "bugs": {
    "url": "https://github.com/Zemdomu/ZemDomu-action/issues"
  },
  "author": "Zacharias Eryd Berlin",
  "license": "MIT",
  "funding": "https://buymeacoffee.com/zemdomu",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:tsc": "tsc",
    "build:ncc": "ncc build src/index.ts --license licenses.txt -o dist && node scripts/normalize-generated-bundle.mjs dist/index.js dist/licenses.txt",
    "build": "npm run clean && npm run build:ncc",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "prepare": "npm run build",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:fuzz": "node --experimental-strip-types --test tests/fuzz-properties.test.js",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "zemdomu": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vercel/ncc": "^0.45.0",
    "c8": "12.0.0",
    "fast-check": "4.10.2",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
